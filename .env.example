# DeepSeek proxy configuration. Copy to .env and edit. Restart after changes.

# Where to listen (loopback by default).
HOST=127.0.0.1
PORT=8080

# Model name echoed back in API responses (does not change the model used).
MODEL_NAME=deepseek-chat

# Mode: auto (respect the request) / quick / expert.
MODE=auto
# Thinking (reasoning_content): auto / enabled / disabled.
THINKING=auto
# Web search: auto / enabled / disabled.
SEARCH=auto

# ── Account pool ──────────────────────────────────────────────
# Accounts are configured in the WebUI Account Pool or this JSON file.
ACCOUNT_STORE_PATH=data/accounts.json
# Optional: Fernet key to encrypt data/accounts.json at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DEEPSEEK_ENCRYPTION_KEY=

# ── Upstream behaviour ────────────────────────────────────────
# curl_cffi TLS fingerprint profile.
DEEPSEEK_IMPERSONATE=chrome131
# Max simultaneous upstream calls across all accounts (extra requests queue).
DEEPSEEK_MAX_CONCURRENCY=2
# Random sleep (seconds) before each upstream call; 0 disables.
DEEPSEEK_JITTER_SECS=0.4
# Backoff seconds on upstream rate limiting; empty disables retrying.
DEEPSEEK_RATE_LIMIT_RETRY_DELAYS=5,15

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
